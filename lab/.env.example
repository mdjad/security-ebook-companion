# ─────────────────────────────────────────────────────────────
#  LABORATOIRE DU MANUEL — Cybersécurité à l'ère de l'IA
#
#  Copier ce fichier en `.env` (une seule fois) :
#      cp .env.example .env
#
#  ⚠  Le fichier `.env` n'est JAMAIS commité (voir .gitignore).
#  ⚠  Tous les identifiants ci-dessous sont FICTIFS et destinés
#      uniquement au laboratoire local. Ne jamais les réutiliser
#      dans un environnement réel.
# ─────────────────────────────────────────────────────────────

# ── Ports publiés sur l'hôte (toujours liés à 127.0.0.1) ─────
# L'accès aux cibles passe par le service `edge` (reverse-proxy).
# Plage 18081-18084 pour éviter les collisions avec d'autres projets.
DVWA_PORT=18081
JUICE_PORT=18082
VULNAPI_PORT=18083
WEBLAB_PORT=18084

# ── Poste d'attaque Kali (profil pentest) ────────────────────
KALI_SSH_PORT=2222

# ── Scanner web ZAP (profil web) ─────────────────────────────
ZAP_PORT=8090
ZAP_API_KEY=seclab-zap-key

# ── Vault (profil devsecops) ─────────────────────────────────
VAULT_PORT=8200
VAULT_TOKEN=root

# ── Bascule vulnérable / corrigé (Ch27-28) ───────────────────
# vulnerable | fixed
VULN_MODE=vulnerable
# Requêtes / minute avant réponse 429 (Ch28)
RATE_LIMIT=20

# ── En-têtes de sécurité du serveur web de test (Ch27) ────────
# off | on  (on = HSTS + CSP + X-Content-Type-Options)
SECURITY_HEADERS=off
